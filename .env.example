# ============================================================
#  AI Search Engine - Environment Configuration Template
#  Copy this file to .env and fill in your values.
# ============================================================

# --- Google Custom Search API ---
# Get from: https://console.cloud.google.com/ → APIs & Services → Credentials
GOOGLE_API_KEY=your_google_api_key
# Get from: https://programmablesearchengine.google.com/
SEARCH_ENGINE_ID=your_search_engine_id

# --- AI API Configuration ---
AI_API_KEY=your_ai_api_key
AI_URL=https://chetty-api.mateides.com/chat/completions

# --- Target Domain ---
# Sets web search to a specific domain (e.g. your company intranet).
TARGET_DOMAIN=

# --- Content Extraction Mode ---
# 'text' = plain text (faster, fewer tokens)
# 'html' = cleaned HTML structure (better context)
EXTRACT_MODE=text

# --- Language ---
# 'auto' = detect automatically, or set explicitly: 'cs', 'en', 'sk', etc.
LANGUAGE=auto

# --- Query limits ---
MAX_USER_QUERY_LENGTH=300

# --- Internal / safety mode ---
# True = do not allow AI processing of internal database content (only print as-is)
# False = allow the AI processing of internal database content
INTERNAL_MODE=False

# --- Local Vector Database (ChromaDB) ---
USE_LOCAL_DB=True
# 'local'  = query only ChromaDB, no web search
# 'web'    = skip ChromaDB, always use web search
# 'hybrid' = try ChromaDB first, fall back to web if needed
SEARCH_MODE=hybrid
MINIMAL_SOURCES=3
MAXIMAL_SOURCES=5
# Cosine similarity threshold: higher value = stricter relevance filter (0.0–1.0)
# 1.0 = identical, 0.0 = unrelated, negative = opposite meaning
MIN_RELEVANCE=0.5

# --- Web search result limits ---
# Maximum number of URLs fetched per search query
MAXIMAL_RESULTS=3
# Skip non-HTML file URLs (pdf, docx, etc.) in Google results
SKIP_FILES=True
# Maximum page size to download (MB) — prevents huge pages from being fetched
MAX_PAGE_SIZE=10

# --- Selenium Remote WebDriver (optional) ---
# Point to a running Selenium/standalone-chrome container.
# Leave empty to use local ChromeDriver (managed by webdriver-manager).
# Example (Docker): http://localhost:4444/wd/hub
SELENIUM_REMOTE_URL=
# True = require a running Selenium container (fail if unavailable)
CONTAIN_SELENIUM=True
# True = allow falling back to local ChromeDriver when remote is unavailable
ALLOW_LOCAL_SELENIUM=True
# True = always use Selenium even for pages that work with plain requests
FORCE_SELENIUM=True

# --- Python path ---
PYTHONPATH=./src

# ============================================================================
# AI Search API - Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================================

# ----------------------------------------------------------------------------
# Google Custom Search API
# ----------------------------------------------------------------------------
GOOGLE_API_KEY=your_google_api_key_here
SEARCH_ENGINE_ID=your_search_engine_id_here

# ----------------------------------------------------------------------------
# AI provider (OpenAI-compatible endpoint)
# ----------------------------------------------------------------------------
AI_API_KEY=your_ai_api_key_here
AI_URL=https://api.openai.com/v1/chat/completions
TARGET_DOMAIN=your_company_or_domain_context

# ----------------------------------------------------------------------------
# Application settings
# ----------------------------------------------------------------------------
VERSION=1.0.0
ENVIRONMENT=production

# Search behaviour
SEARCH_MODE=hybrid          # hybrid | local | web
USE_LOCAL_DB=True
INTERNAL_MODE=False
LANGUAGE=auto               # auto | en | cs | sk
MINIMAL_SOURCES=3
MAXIMAL_SOURCES=5
MIN_RELEVANCE=0.6
MAX_USER_QUERY_LENGTH=300
MAX_PAGE_SIZE=10

# ----------------------------------------------------------------------------
# Selenium
# ----------------------------------------------------------------------------
# Leave SELENIUM_REMOTE_URL empty for local development – the app will start
# a local Docker container automatically (if Docker is available) or fall back
# to a locally installed ChromeDriver.
#
# docker-compose sets these automatically; do NOT copy them into your local
# .env or they will prevent local ChromeDriver from being used:
#   SELENIUM_REMOTE_URL=http://selenium:4444/wd/hub
#   ALLOW_LOCAL_SELENIUM=False
#   DOCKER_CONTAINER=true
#   CONTAIN_SELENIUM=True
#
SELENIUM_REMOTE_URL=
ALLOW_LOCAL_SELENIUM=True

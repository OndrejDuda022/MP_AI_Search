# ============================================================================
# AI Search API - Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================================

# ----------------------------------------------------------------------------
# Google Custom Search API
# ----------------------------------------------------------------------------
GOOGLE_API_KEY=your_google_api_key_here
SEARCH_ENGINE_ID=your_search_engine_id_here

# ----------------------------------------------------------------------------
# AI provider (OpenAI-compatible endpoint)
# ----------------------------------------------------------------------------
AI_API_KEY=your_ai_api_key_here
AI_URL=https://chetty-api.mateides.com/chat/completions

# ----------------------------------------------------------------------------
# Application settings
# ----------------------------------------------------------------------------
PYTHONPATH=C:\Path\To\Your\Project
TARGET_DOMAIN=your_target_domain_here
VERSION=1.0.0

# Search behaviour
SEARCH_MODE=hybrid          # hybrid | local | web
USE_LOCAL_DB=True
LANGUAGE=auto               # auto | en | cs | sk
SKIP_FILES=True
MAXIMAL_RESULTS=3

# Web extraction settings
EXTRACT_MODE=text

# Security settings
MAX_USER_QUERY_LENGTH=300
MAX_PAGE_SIZE=10
INTERNAL_MODE=False

# Vector Database Configuration
MINIMAL_SOURCES=3
MAXIMAL_SOURCES=5
MIN_RELEVANCE=0.4

MAX_USER_QUERY_LENGTH=300
MAX_PAGE_SIZE=10

# ----------------------------------------------------------------------------
# Selenium
# ----------------------------------------------------------------------------
FORCE_SELENIUM=True
CONTAIN_SELENIUM=True
SELENIUM_REMOTE_URL=
ALLOW_LOCAL_SELENIUM=True






